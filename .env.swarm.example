# =============================================================================
# Swarm OS — Environment Configuration Template
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file to `.env` at the repo root:
#        cp .env.swarm.example .env
#   2. Fill in only the keys you need.
#      Leave anything blank to keep the pipeline in dry-run (stub) mode.
#   3. Run:  ./start.sh
#      start.sh auto-sources .env at boot, so all child processes
#      (uvicorn, the Vite dev server) inherit these values.
#
# IMPORTANT:
#   - .env is already in .gitignore — it will NEVER be committed.
#   - You do NOT need to fill any of these to test the dashboard;
#     POST http://localhost:8000/swarm/run works with no keys (dry-run).
#   - For dashboard-only env overrides, use dashboard/.env.local
#     (Vite reads VITE_* variables from there).
#
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SCRIPT LLM (script_node)  — pick ONE provider
# -----------------------------------------------------------------------------
# Default provider is "anthropic". Override with SWARM_SCRIPT_PROVIDER=openai
# to use OpenAI instead. SWARM_SCRIPT_MODEL overrides the default model id.

SWARM_SCRIPT_PROVIDER=anthropic
# SWARM_SCRIPT_MODEL=claude-sonnet-4-6

# Anthropic — required if SWARM_SCRIPT_PROVIDER=anthropic
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — required only if SWARM_SCRIPT_PROVIDER=openai
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# 2. VOICEOVER (voiceover_node) — ElevenLabs
# -----------------------------------------------------------------------------
# Required for real voiceovers. Without these, voiceover_node returns a
# stub MP3 URL and the rest of the pipeline still runs end-to-end.
#
# Get a key at:  https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_AUDIO_PUT_URL must be a pre-signed S3 (or compatible) PUT URL
# where the generated MP3 will be uploaded. The resulting object URL is then
# fed to Shotstack as the audio track.

ELEVENLABS_API_KEY=
ELEVENLABS_AUDIO_PUT_URL=

# -----------------------------------------------------------------------------
# 3. B-ROLL (broll_node) — Sora 2 OR Veo 3.1
# -----------------------------------------------------------------------------
# Pick ONE provider. Leave SWARM_BROLL_PROVIDER unset to use the static
# placeholder clip (good for dry-run / dashboard demos).

# SWARM_BROLL_PROVIDER=sora           # OpenAI Sora 2 (POST /v1/videos)
# SWARM_BROLL_PROVIDER=veo            # Google Vertex AI Veo 3.1

# Sora — required if SWARM_BROLL_PROVIDER=sora
SORA_API_KEY=

# Veo — required if SWARM_BROLL_PROVIDER=veo
# Either a Google API key OR Application Default Credentials in the env.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
VEO_API_KEY=

# -----------------------------------------------------------------------------
# 4. VIDEO RENDERING (video_assembly_node) — Shotstack
# -----------------------------------------------------------------------------
# Required for real cloud renders. Without it, video_assembly_node returns
# a stub MP4 URL (the publish step then logs to the dry-run feed).
#
# Get a key at:  https://dashboard.shotstack.io/

SHOTSTACK_API_KEY=

# -----------------------------------------------------------------------------
# 5. PUBLISHING (publish_node) — YouTube Data API v3
# -----------------------------------------------------------------------------
# Required to actually upload to YouTube. You need:
#   1. An OAuth 2.0 client (Desktop or Web) from
#        https://console.cloud.google.com/apis/credentials
#   2. A refresh token obtained once (e.g. via Google's OAuth Playground
#        or the youtube-oauth-helper tool) for a Google account that owns
#        the target channel, with scope:
#            https://www.googleapis.com/auth/youtube.upload
#
# YOUTUBE_DEFAULT_PRIVACY may be: private | unlisted | public
# Defaults to "private" so nothing goes live until you flip the flag.

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_DEFAULT_PRIVACY=private

# -----------------------------------------------------------------------------
# 6. HERMES STORAGE
# -----------------------------------------------------------------------------
# Where the swarm writes the published-video log + cached artifacts.
# Defaults to ~/.hermes when unset.
# HERMES_HOME=/var/lib/hermes
